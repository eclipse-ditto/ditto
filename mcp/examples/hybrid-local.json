{
  "knowledge": {
    "retriever": "hybrid",
    "publicSource": {
      "enabled": true
    },
    "localDir": {
      "enabled": true,
      "path": "/path/to/your/markdown"
    },
    "embedding": {
      "model": "Xenova/bge-small-en-v1.5",
      "dim": 384,
      "allowRemoteModels": true,
      "batchSize": 32
    },
    "store": {
      "kind": "sqlite",
      "sqlite": {
        "path": "./ditto-index.db"
      }
    }
  }
}
