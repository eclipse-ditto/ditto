{
  "ditto": {
    "enabled": true,
    "baseUrl": "http://localhost:8080",
    "credential": {
      "kind": "oidc",
      "tokenUrl": "https://idp.example/token",
      "clientId": "REPLACE_ME_APP_CLIENT",
      "clientSecret": "REPLACE_ME"
    },
    "devopsCredential": {
      "kind": "oidc",
      "tokenUrl": "https://idp.example/token",
      "clientId": "REPLACE_ME_DEVOPS_CLIENT",
      "clientSecret": "REPLACE_ME"
    },
    "policy": {
      "allowMethods": ["GET"],
      "writeAllowlist": ["putThing"],
      "sudoAllowlist": ["sudoRetrieveThing", "getConnections"]
    }
  }
}
