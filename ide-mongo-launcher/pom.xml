<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.eclipse.ditto</groupId>
        <artifactId>ditto-bom</artifactId>
        <version>${revision}</version>
        <relativePath>../bom/pom.xml</relativePath>
    </parent>
    <artifactId>ditto-ide-mongo-launcher</artifactId>
    <packaging>jar</packaging>
    <name>Eclipse Ditto :: IDE MongoDB Launcher</name>

    <!--
        LOCAL-DEV / IDE ONLY — this module ships no code and is never published or bundled.

        Its sole purpose is to give the default IntelliJ run configurations one module whose classpath carries BOTH a
        service (things/policies/connectivity/thing-search) AND the MongoDB backends
        (ditto-internal-utils-persistence for event-sourcing persistence + ditto-thingsearch-persistence-mongo for
        thing-search: the providers, the Pekko MongoDB journal/snapshot plugins, the ditto-mongo-*.conf profile
        resources behind the fixed-name ditto-persistence-backend / ditto-search-backend includes, and the MongoDB
        driver).

        Why this module exists instead of a dependency on the service itself:
          * The service modules carry MongoDB at test scope only: in production MongoDB ships as separate drop-in
            extension JARs, like PostgreSQL, so the services' shaded allinones hold no persistence backend.
          * An IntelliJ "Application" run configuration uses only a module's PRODUCTION (compile/runtime) classpath,
            never its test scope, so the services' test-scope MongoDB dependencies never reach the run classpath.
        Pointing the default run configs' "Use classpath of module" at THIS module (while keeping the service's own
        main class, e.g. org.eclipse.ditto.policies.service.starter.PoliciesService) puts MongoDB on the
        production/compile classpath without touching the service modules or their allinones.

        Leak-free by construction: this module is never listed in any service's maven-shade artifact set and is never
        deployed, so carrying MongoDB here at compile scope cannot reach a published service image.
    -->

    <properties>
        <!-- Dev-only aggregator: never deploy this (essentially empty) jar to a repository. -->
        <maven.deploy.skip>true</maven.deploy.skip>
    </properties>

    <dependencies>
        <!--
            The services whose default run configs point their classpath at this module. Each contributes its own
            main class + service config (e.g. policies.conf with read-journal.entity="policies").
        -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-policies-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-things-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-connectivity-service</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-thingsearch-service</artifactId>
        </dependency>
        <!--
            The MongoDB persistence backend: MongoPersistenceBackendProvider and its bootstrap (picked by the
            fixed-name ditto-persistence-backend include of each service conf, since this classpath holds only the
            MongoDB backend), the Pekko MongoDB journal/snapshot plugins, the ditto-mongo-persistence.conf profile
            and the MongoDB driver.
        -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-persistence</artifactId>
        </dependency>
        <!--
            The MongoDB SEARCH backend the "SearchService" run config needs: MongoSearchPersistenceProvider (picked by
            the fixed-name ditto-search-backend include of search.conf), the search read/write/aggregation impls and
            the ditto-mongo-search.conf profile.
        -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-thingsearch-persistence-mongo</artifactId>
        </dependency>

        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
