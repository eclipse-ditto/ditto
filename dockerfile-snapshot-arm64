FROM docker.io/arm64v8/eclipse-temurin:25-jdk

# Http port
EXPOSE 8080

ENV DITTO_HOME=/opt/ditto \
    DITTO_LOGS=/var/log/ditto

RUN set -x \
    && apt-get update \
    && apt-get install -y tini curl \
    && mkdir -p $DITTO_HOME \
    && mkdir -p $DITTO_LOGS \
    && groupadd --system --gid 1005 ditto \
    && useradd --no-log-init --system --home-dir $DITTO_HOME --shell /bin/sh --gid ditto --uid 1005 ditto \
    && chown -R ditto:ditto $DITTO_HOME $DITTO_LOGS \
    && rm -rf /var/lib/apt/lists/*

ARG TARGET_DIR
ARG SERVICE_STARTER
ARG SERVICE_VERSION
ARG JVM_CMD_ARGS=""
ARG MAIN_CLASS

ENV HTTP_PORT=8080 \
    HOSTING_ENVIRONMENT=Docker \
    JVM_CMD_ARGS_ENV=${JVM_CMD_ARGS} \
    MAIN_CLASS_ENV=${MAIN_CLASS} \
    DITTO_PERSISTENCE_BACKEND=mongodb

USER ditto
WORKDIR $DITTO_HOME
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["sh", "-c", "exec java ${JVM_CMD_ARGS_ENV} -cp \"/opt/ditto/*:/opt/ditto/backends/${DITTO_PERSISTENCE_BACKEND}/*:/opt/ditto/extensions/*\" ${MAIN_CLASS_ENV}"]

COPY --chown=ditto:ditto ${TARGET_DIR}/${SERVICE_STARTER}-${SERVICE_VERSION}-allinone.jar $DITTO_HOME

# Both persistence backends, staged by stage-backends.sh into backends/{mongodb,postgresql}/;
# DITTO_PERSISTENCE_BACKEND puts one of them on the java classpath (CMD above).
# The extensions dir is staged empty: $DITTO_HOME/extensions/ is on the classpath for user JARs mounted at runtime.
COPY --chown=ditto:ditto ${TARGET_DIR}/backends/ $DITTO_HOME/backends/
COPY --chown=ditto:ditto ${TARGET_DIR}/extensions/ $DITTO_HOME/extensions/
