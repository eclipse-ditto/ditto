<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ditto</groupId>
        <artifactId>ditto-internal-utils</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ditto-postgres-persistence-extension</artifactId>
    <packaging>jar</packaging>
    <name>Eclipse Ditto :: Postgres :: Persistence Extension (thin)</name>

    <!--
        THIN event-sourcing persistence extension jar (§6 D2 — three-JAR layered packaging).

        Carries ONLY the ditto-internal-utils-persistence-r2dbc implementation classes (the Postgres event-sourcing
        journal/snapshot/ops/read-journal + PostgresPersistenceBackendProvider) plus their conf resources
        (ditto-postgres-persistence.conf). It carries NO third-party: the r2dbc/reactor/netty/scram runtime and the
        shared postgres-client infrastructure live in the BASE jar (ditto-postgres-client-extension), which MUST be
        mounted alongside this jar. things/policies/connectivity therefore mount TWO jars — a documented change from the
        former single ditto-internal-utils-persistence-r2dbc-extension jar.

        The version marker (META-INF/ditto-postgres-extension.properties) makes this jar's release visible to the boot
        self-check (PostgresExtensionVersions, invoked from PostgresPersistenceBackendProvider) so a base/persistence
        version mismatch fails fast.

        It is NOT a dependency of any service module and NOT bundled in the published images.
    -->

    <dependencies>
        <!-- The only compile dependency: the Ditto r2dbc event-sourcing persistence module (version bom-managed).
             postgres-client (its transitive) is deliberately NOT bundled here — it ships in the base jar. -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-persistence-r2dbc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <!--
                        Always rebuild the thin project JAR that shade:shade below takes as its input. Without this, an
                        incremental `mvn install` (no `clean`) finds the artifact already in target/ "up to date" (this
                        module's own sources rarely change) and keeps it; but that artifact is the PREVIOUS shaded JAR
                        (shade replaces the main artifact in place). shade:shade then merges it with the freshly built
                        persistence-r2dbc JAR and keeps the first copy of every overlapping class, i.e. the stale one,
                        while every build step reports success. build-images.sh refuses such a JAR; this removes the cause.
                    -->
                    <forceCreation>true</forceCreation>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <artifactSet>
                                <!--
                                    THIN whitelist: ONLY the persistence-r2dbc module itself. All third-party
                                    (r2dbc/reactor/netty/scram) and the shared postgres-client infra are provided by the
                                    base jar (ditto-postgres-client-extension) — bundling them here too would duplicate
                                    classes across the two mounted jars.
                                -->
                                <includes>
                                    <include>org.eclipse.ditto:ditto-internal-utils-persistence-r2dbc</include>
                                </includes>
                            </artifactSet>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>LICENSE</exclude>
                                        <exclude>LICENSE.txt</exclude>
                                        <exclude>NOTICE</exclude>
                                        <exclude>THIRD-PARTY.txt</exclude>
                                        <exclude>README.md</exclude>
                                        <exclude>rootdoc.txt</exclude>
                                        <exclude>META-INF/NOTICE</exclude>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                            <transformers>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer"/>
                                <transformer
                                        implementation="org.apache.maven.plugins.shade.resource.AppendingTransformer">
                                    <resource>reference.conf</resource>
                                </transformer>
                            </transformers>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
