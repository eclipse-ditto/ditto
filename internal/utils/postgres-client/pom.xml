<project xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns="http://maven.apache.org/POM/4.0.0"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.eclipse.ditto</groupId>
        <artifactId>ditto-internal-utils</artifactId>
        <version>${revision}</version>
    </parent>

    <artifactId>ditto-internal-utils-postgres-client</artifactId>
    <name>Eclipse Ditto :: Internal :: Utils :: Postgres Client</name>

    <!--
        Backend-agnostic PostgreSQL client + schema infrastructure shared by the event-sourcing persistence
        backend (persistence-r2dbc) and the upcoming search backend (search-r2dbc). It carries the r2dbc
        connection pool/DDL/health/metrics machinery and the descriptor-parameterised schema manager, but
        NONE of the event-sourcing (journal/snapshot/read-journal) specifics. Consumers supply their own
        PostgresSchemaDescriptor. Being an r2dbc-carrying module it is equally banned from the service
        allinones (enforce-no-r2dbc-in-service).
    -->

    <dependencies>
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-config</artifactId>
        </dependency>
        <!-- Metrics facade (DittoMetrics/Timer/Histogram/Gauge) for the R2DBC -> Kamon observability.
             Brings io.kamon:kamon-core transitively (kamon.version managed in bom). -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-metrics</artifactId>
        </dependency>
        <!-- Health subsystem base (AbstractHealthCheckingActor + StatusInfo) for the SELECT 1 health-check actor,
             mirroring the Mongo backend's MongoHealthChecker. A leaf util (json/base-model/pekko/config) — no cycle. -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-health</artifactId>
        </dependency>

        <!-- Pekko: the client extension owns the single per-actor-system pool + CoordinatedShutdown tasks;
             DittoPostgresClient bridges the reactive-streams Publisher to Pekko via Source.fromPublisher. -->
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-actor_${scala.version}</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-stream_${scala.version}</artifactId>
        </dependency>

        <!-- R2DBC SPI + pooling + driver: pure SPI libraries, NO upstream pekko-persistence-r2dbc plugin [M10] -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-pool</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>r2dbc-postgresql</artifactId>
        </dependency>
        <!-- r2dbc-proxy: observability hooks (command timer + acquire-latency) -->
        <dependency>
            <groupId>io.r2dbc</groupId>
            <artifactId>r2dbc-proxy</artifactId>
        </dependency>

        <dependency>
            <groupId>com.google.code.findbugs</groupId>
            <artifactId>jsr305</artifactId>
        </dependency>

        <!-- test dependencies -->
        <dependency>
            <groupId>org.eclipse.ditto</groupId>
            <artifactId>ditto-internal-utils-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>nl.jqno.equalsverifier</groupId>
            <artifactId>equalsverifier</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-stream-testkit_${scala.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-testkit_${scala.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.pekko</groupId>
            <artifactId>pekko-slf4j_${scala.version}</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- Testcontainers: drives the schema-manager bootstrap IT (*IT runs under failsafe, skipped offline).
             The PostgresDbResource fixture is published as a test-jar so persistence-r2dbc (and later search-r2dbc)
             reuse the identical container fixture without depending on each other's test tree. -->
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>postgresql</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <!-- Publish the Testcontainers PostgresDbResource fixture as a test-jar for downstream module ITs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                        <configuration>
                            <includes>
                                <include>org/eclipse/ditto/internal/utils/persistence/postgres/client/testkit/*</include>
                            </includes>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>

</project>
